APP_NAME=FastAPI Microservices Platform
APP_VERSION=2.0.0
ENVIRONMENT=development
DEBUG=false
DOCS_ENABLED=true

DATABASE_URL=sqlite+aiosqlite:///./app.db
# Local/test convenience only. Set false in staging/production and run
# versioned database migrations as a deployment step.
AUTO_CREATE_SCHEMA=true
DATABASE_HEALTH_TIMEOUT_SECONDS=3

# Required in staging and production; must contain at least 32 characters.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30

# JSON arrays are required for list-valued pydantic-settings variables.
ALLOWED_HOSTS=["localhost","127.0.0.1","test","testserver"]
CORS_ORIGINS=[]

# Single-process protection for login and registration. Use a shared limiter
# or trusted ingress when running more than one application process.
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_ENTRIES=10000
