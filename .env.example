APP_NAME=FastAPI Webhook Platform
APP_VERSION=3.0.0
ENVIRONMENT=development
DEBUG=false
DOCS_ENABLED=true

DATABASE_URL=sqlite+aiosqlite:///./app.db
# Local/test only. Deployments must set false and run `alembic upgrade head`.
AUTO_CREATE_SCHEMA=true
DATABASE_HEALTH_TIMEOUT_SECONDS=3

# Required in staging/production and at least 32 characters each. When empty,
# development/test generate process-local values and emit stderr warnings.
SECRET_KEY=
API_KEY_PEPPER=
WEBHOOK_SIGNING_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Empty derives true only in development. Explicit true is rejected elsewhere.
ALLOW_HTTP_WEBHOOKS=
ALLOWED_HOSTS=["localhost","127.0.0.1","test","testserver"]
CORS_ORIGINS=[]

RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_ENTRIES=10000

WORKER_POLL_SECONDS=1
WORKER_BATCH_SIZE=50
WORKER_CONCURRENCY=10
WORKER_LEASE_SECONDS=60
HTTP_CONNECT_TIMEOUT_SECONDS=5
HTTP_READ_TIMEOUT_SECONDS=10
HTTP_WRITE_TIMEOUT_SECONDS=10
HTTP_POOL_TIMEOUT_SECONDS=5
WEBHOOK_PAYLOAD_MAX_BYTES=262144
WEBHOOK_RESPONSE_MAX_BYTES=16384
IDEMPOTENCY_KEY_MAX_LENGTH=255
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_BACKOFF_BASE_SECONDS=1
WEBHOOK_BACKOFF_CAP_SECONDS=3600
