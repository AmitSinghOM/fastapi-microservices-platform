APP_NAME=FastAPI Microservices Platform
DEBUG=false
DATABASE_URL=sqlite+aiosqlite:///./app.db

# Signing key for access tokens. REQUIRED in any real deployment.
# Must be at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave unset only for local runs: the app then generates a random key per
# process, so every restart invalidates all issued tokens.
SECRET_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=30

# Rate limit on unauthenticated endpoints (login, registration), per client IP.
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
