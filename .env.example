APP_NAME=FastAPI Webhook Platform
APP_VERSION=3.0.0
ENVIRONMENT=development
DEBUG=false
DOCS_ENABLED=true
# Compatibility-only tutorial API. Default changes to false in version 4.0.
EXAMPLE_ITEMS_ENABLED=true

DATABASE_URL=sqlite+aiosqlite:///./app.db
# Local/test only. Deployments must set false and run `alembic upgrade head`.
AUTO_CREATE_SCHEMA=true
DATABASE_HEALTH_TIMEOUT_SECONDS=3
# Per-process PostgreSQL pools multiplied by replica counts must fit the shared
# connection budget: API_REPLICA_COUNT*(API_DB_POOL_SIZE+API_DB_MAX_OVERFLOW)
# + WORKER_REPLICA_COUNT*(WORKER_DB_POOL_SIZE+WORKER_DB_MAX_OVERFLOW).
API_DB_POOL_SIZE=5
API_DB_MAX_OVERFLOW=5
API_DB_POOL_TIMEOUT_SECONDS=5
WORKER_DB_POOL_SIZE=5
WORKER_DB_MAX_OVERFLOW=5
WORKER_DB_POOL_TIMEOUT_SECONDS=5
API_REPLICA_COUNT=1
WORKER_REPLICA_COUNT=1
DATABASE_CONNECTION_BUDGET=20

# Required in staging/production and at least 32 characters each. When empty,
# development/test generate process-local values and emit stderr warnings.
SECRET_KEY=
API_KEY_PEPPER=
WEBHOOK_SIGNING_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Empty derives true only in development. Explicit true is rejected elsewhere.
ALLOW_HTTP_WEBHOOKS=
ALLOWED_HOSTS=["localhost","127.0.0.1","test","testserver"]
CORS_ORIGINS=[]

RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_ENTRIES=10000

WORKER_POLL_SECONDS=1
WORKER_BATCH_SIZE=50
WORKER_CONCURRENCY=10
# Deployment-wide limits shared by all worker replicas through PostgreSQL.
WORKER_GLOBAL_CONCURRENCY=10
WORKER_EGRESS_CONNECTION_BUDGET=10
WORKER_CANDIDATE_SCAN_LIMIT=5000
# Must exceed attempt timeout + heartbeat interval + finalization margin.
WORKER_LEASE_SECONDS=60
WORKER_HEARTBEAT_SECONDS=10
WORKER_ATTEMPT_TIMEOUT_SECONDS=30
WORKER_FINALIZATION_MARGIN_SECONDS=5
# Must cover attempt timeout + finalization margin.
WORKER_SHUTDOWN_GRACE_SECONDS=45
# Required in staging/production. Use a credential-free internal HTTP CONNECT
# proxy; workers ignore ambient HTTP(S)_PROXY and NO_PROXY variables.
WORKER_EGRESS_PROXY_URL=
HTTP_CONNECT_TIMEOUT_SECONDS=5
HTTP_READ_TIMEOUT_SECONDS=10
HTTP_WRITE_TIMEOUT_SECONDS=10
HTTP_POOL_TIMEOUT_SECONDS=5

# Replica-shared tenant admission and fair-delivery limits.
TENANT_EVENT_RATE_PER_SECOND=100
TENANT_EVENT_BURST=200
TENANT_DELIVERY_RATE_PER_SECOND=500
TENANT_DELIVERY_BURST=1000
TENANT_REPLAY_RATE_PER_SECOND=10
TENANT_REPLAY_BURST=20
TENANT_ENDPOINTS_PER_PROJECT=100
TENANT_FANOUT_PER_EVENT=100
TENANT_IN_FLIGHT_DELIVERIES=10
TENANT_RETAINED_BYTES=1073741824
ENDPOINT_CONCURRENCY=10
ENDPOINT_RATE_PER_SECOND=50
ENDPOINT_RATE_BURST=100
GLOBAL_MAX_BACKLOG=100000
GLOBAL_OLDEST_DUE_ADMISSION_SECONDS=300
QUOTA_RETRY_AFTER_MAX_SECONDS=60

WEBHOOK_PAYLOAD_MAX_BYTES=262144
WEBHOOK_RESPONSE_MAX_BYTES=16384
IDEMPOTENCY_KEY_MAX_LENGTH=255
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_BACKOFF_BASE_SECONDS=1
WEBHOOK_BACKOFF_CAP_SECONDS=3600
# Retry-After is clamped and cannot extend work beyond maximum delivery age.
WEBHOOK_RETRY_AFTER_MAX_SECONDS=3600
WEBHOOK_MAX_DELIVERY_AGE_SECONDS=86400
# Retry tokens are shared per endpoint; original attempts do not consume them.
ENDPOINT_RETRY_RATE_PER_SECOND=0.1
ENDPOINT_RETRY_BURST=10
ENDPOINT_RETRY_SUCCESS_REFILL=1
ENDPOINT_CIRCUIT_FAILURE_THRESHOLD=5
ENDPOINT_CIRCUIT_OPEN_SECONDS=60
BULK_REPLAY_MAX_DELIVERIES=100
DELIVERY_RETENTION_DAYS=30
DELIVERY_PURGE_BATCH_SIZE=500

# API-key last-used timestamps are coalesced and persisted asynchronously.
API_KEY_USAGE_FLUSH_SECONDS=30
API_KEY_USAGE_MAX_ENTRIES=10000

# Metrics contain fixed labels only. API metrics use METRICS_PATH; worker
# metrics bind independently and should remain on a private monitoring network.
OBSERVABILITY_ENABLED=true
METRICS_PATH=/metrics
WORKER_METRICS_HOST=127.0.0.1
WORKER_METRICS_PORT=9100
OBSERVABILITY_COLLECTION_SECONDS=15
TRACING_ENABLED=true
OTEL_SERVICE_NAME=webhook-platform
# OTLP/HTTP base endpoint. Use TLS outside local development.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=false
TRACE_SAMPLE_RATIO=0.1
# Scale bounds must fit database, egress, NAT, and destination budgets.
AUTOSCALING_MIN_WORKER_REPLICAS=1
AUTOSCALING_MAX_WORKER_REPLICAS=1
NAT_CONNECTION_BUDGET=10
