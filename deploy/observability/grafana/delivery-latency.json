{
  "title": "Webhook Delivery Latency",
  "uid": "webhook-delivery-latency",
  "schemaVersion": 39,
  "refresh": "15s",
  "time": {"from": "now-6h", "to": "now"},
  "panels": [
    {
      "type": "timeseries",
      "title": "End-to-end p95",
      "targets": [{"expr": "histogram_quantile(0.95, sum by(le, outcome) (rate(webhook_delivery_end_to_end_seconds_bucket[5m])))", "legendFormat": "{{outcome}}"}],
      "fieldConfig": {"defaults": {"unit": "s"}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
    },
    {
      "type": "timeseries",
      "title": "Arrival and completion rates",
      "targets": [{"expr": "webhook:arrival_rate5m", "legendFormat": "arrival"}, {"expr": "webhook:completion_rate5m", "legendFormat": "completion"}],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
    }
  ]
}
