{
  "title": "Webhook Failure Isolation",
  "uid": "webhook-failure-isolation",
  "schemaVersion": 39,
  "refresh": "15s",
  "time": {"from": "now-6h", "to": "now"},
  "panels": [
    {
      "type": "timeseries",
      "title": "Failure rate by safe class",
      "targets": [{"expr": "sum by(failure_class) (rate(webhook_delivery_failures_total[5m]))", "legendFormat": "{{failure_class}}"}],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
    },
    {
      "type": "timeseries",
      "title": "Aggregate circuit states",
      "targets": [{"expr": "max by(state) (webhook_circuit_endpoints)", "legendFormat": "{{state}}"}],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
    }
  ]
}
